# ── Google Sheets ─────────────────────────────────────────────
# Spreadsheet ID dari URL: docs.google.com/spreadsheets/d/[ID]/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Path ke file credentials service account Google
# Local dev: ./credentials.json (default jika kosong). Fly.io: /data/credentials.json
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Nama sheet tab untuk reminder (default: Reminders)
SHEET_REMINDER_TAB=Reminders
SHEET_MANUAL_TAB=MyReminders

# ── WhatsApp ───────────────────────────────────────────────────
# Nomormu sendiri (untuk terima laporan harian), format: 628xxx
OWNER_NUMBER=628xxxxxxxxxx
ALLOWED_NUMBERS=628xxxxxxxxxx

# LID identifiers yang boleh akses bot (untuk WhatsApp @lid format, pisah koma)
ALLOWED_LIDS=

# ── Web dashboard ─────────────────────────────────────────────
# Password/token for https://your-app.fly.dev dashboard API.
# Set this on Fly with: flyctl secrets set DASHBOARD_TOKEN="long-random-value" --app your-app
DASHBOARD_TOKEN=change_this_for_dashboard

# (Opsional) Approval untuk !done dari non-approver
# Jika true, maka user yang bukan approver akan kirim request dan status baru berubah setelah disetujui.
DONE_REQUIRE_OWNER_APPROVAL=false
DONE_APPROVAL_TTL_MS=900000

# Siapa saja yang boleh !approve / !reject (default: OWNER_NUMBER).
# Kamu bisa tulis "OWNER_NUMBER" sebagai token.
APPROVER_NUMBERS=OWNER_NUMBER,62xxxxxxxxxx,62yyyyyyyyyy

# Label yang muncul di chat untuk pihak approver (default: Abang)
APPROVER_LABEL=Abang

# Nama untuk nomor (buat tampil "ditandai selesai oleh Nama")
# Format: 628xxx=Nama,628yyy=Nama2
NUMBER_NAME_MAP=62xxxxxxxxxx=Name,62yyyyyyyyyy=Name2

# Tab opsional untuk override status auto-import jika alur deploy kamu memakainya.
# Setup saat ini dapat menandai status done langsung lewat command bot untuk nomor yang diizinkan.
SHEET_OVERRIDE_TAB=BotOverrides

# ── Fun sticker command ───────────────────────────────────────
# Path file sticker WebP untuk command !damn (dibuat via !setdamn)
# Local dev: ./data/damn.webp (default). Fly.io: /data/damn.webp
DAMN_STICKER_PATH=./data/damn.webp

# ── Scheduler ─────────────────────────────────────────────────
# Jam pengiriman reminder harian (format 24 jam, WIB = UTC+7)
# Default: setiap hari jam 08:00 pagi
REMINDER_CRON=0 8 * * *

# ── Notifikasi H- berapa hari sebelum deadline ─────────────────
# Pisah dengan koma. Contoh: 7,3,1,0 artinya 7 hari, 3 hari, 1 hari, dan hari H
NOTIFY_DAYS_BEFORE=7,3,1,0

# ── Runtime paths ─────────────────────────────────────────────
# Folder tempat Baileys nyimpan session (creds + pre-keys).
# Local dev: ./auth_info_baileys (default jika kosong). Fly.io: /data/auth_info_baileys
# Catatan: di production (NODE_ENV=production) path HARUS absolute.
# Kalau kosong atau relative, bot sengaja crash di boot — daripada diam-diam
# bikin session baru di filesystem ephemeral dan print QR yang gak bisa discan.
AUTH_DIR=./auth_info_baileys

# Path file JSON untuk mapping messageId → reminderNo (buat fitur react ✅).
# Local dev: ./data/reactionMap.json (default). Fly.io: /data/reactionMap.json
# Di production (NODE_ENV=production) path HARUS absolute. Kalau kosong atau
# relative, bot crash di boot biar misconfig langsung kelihatan di `flyctl logs`.
REACTION_MAP_PATH=./data/reactionMap.json

# ── Instagram Auto-Ping ───────────────────────────────────────
# Enable/disable Instagram monitoring (true/false)
IG_MONITOR_ENABLED=true

# -- Graph API (PRIMARY method, recommended) --
# Instagram User ID (numeric, from Graph API setup)
# Find via: GET https://graph.instagram.com/me?fields=id,username&access_token=TOKEN
IG_USER_ID=17841401529158080

# Long-lived access token from Facebook/Instagram Graph API
# Lasts 60 days; refresh before expiry
IG_ACCESS_TOKEN=your-long-lived-token-here

# (Optional) Token expiry date in ISO format for automatic warning
# Bot will DM owner once per 24h when within 7 days of expiry
IG_TOKEN_EXPIRES_AT=2025-07-23

# -- Scraping fallback (used when Graph API is not configured or fails) --
# Public Instagram username to monitor (no @ prefix)
IG_USERNAME=himasif

# Cron expression for how often to check for new posts (default: every 5 minutes)
IG_CHECK_CRON=*/5 * * * *

# Where to send notifications: "owner" (sends to OWNER_NUMBER) or a group JID like 120363xxx@g.us
# Also used as the target for !share command notifications and webhook share-target posts
IG_NOTIFY_TARGET=owner

# Secret token for authenticating webhook requests (kept for future Make.com fallback)
# Generate a random string and set the same value in your webhook URL:
# https://your-app.fly.dev/webhook/instagram?token=THIS_VALUE
IG_WEBHOOK_SECRET=your-random-secret-here

# Path to Instagram state file
# Local dev: ./data/igState.json (default). Fly.io: /data/igState.json
IG_STATE_PATH=./data/igState.json

# ── Form Monitor (Webhook) ─────────────────────────────────────
# The form monitor uses a webhook approach: Google Apps Script sends
# data directly to the bot when a form is submitted or edited.
# No cron polling or state file needed.

# Enable/disable Form Response monitoring (true/false)
FORM_MONITOR_ENABLED=true

# Secret token for authenticating webhook requests from Apps Script.
# Generate a random string and configure the same value in your
# Apps Script HTTP POST URL: https://your-app.fly.dev/webhook/form?token=THIS_VALUE
FORM_WEBHOOK_SECRET=your-random-secret-here

# Spreadsheet ID of the Google Form responses sheet (used for link in notifications)
FORM_SPREADSHEET_ID=your-spreadsheet-id

# GID of the sheet tab (used for direct link in notifications)
FORM_SHEET_GID=0

# Where to send notifications: "owner" (sends to OWNER_NUMBER) or a group JID
FORM_NOTIFY_TARGET=owner
