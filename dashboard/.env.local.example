# Google Sheets Spreadsheet ID
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials as JSON string
# Copy the entire content of your credentials.json file here as a single line
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Optional: Tab names (defaults shown)
# SHEET_REMINDER_TAB=Reminders
# SHEET_MANUAL_TAB=MyReminders

# Optional: API authentication token
# If set, the /api/reminders endpoint requires Authorization: Bearer <token>
# Leave unset for local development (no auth required)
# API_SECRET=your_secret_token_here
